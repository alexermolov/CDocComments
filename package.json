{
    "name": "c-doc-comments",
    "version": "1.1.5",
    "publisher": "alexermolov",
    "engines": {
        "vscode": "^1.12.2"
    },
    "displayName": "C Doc Comments",
    "description": "Generate XML/Doxygen documentation comments for C#, C, and C++",
    "categories": [
        "Other"
    ],
    "galleryBanner": {
        "color": "#4F87FF",
        "theme": "light"
    },
    "main": "./out/src/extension",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "C-family Documentation Comments configuration",
            "properties": {
                "docomment.activateOnEnter": {
                    "type": "boolean",
                    "default": false,
                    "description": "Press the Enter key to activate a command."
                }
            }
        }
    },
    "activationEvents": [
        "onLanguage:csharp",
        "onLanguage:c",
        "onLanguage:cpp"
    ],
    "keywords": [
        "C-family Documentation Comments",
        "C#",
        "C++",
        "C"
    ],
    "dependencies": {},
    "devDependencies": {
        "typescript": "^5.3.3",
        "@types/vscode": "^1.12.0",
        "@vscode/test-electron": "^2.3.8",
        "@types/node": "18.x",
        "@types/mocha": "^10.0.6",
        "mocha": "^10.2.0",
        "glob": "^10.3.10",
        "@types/glob": "^8.1.0",
        "@vscode/vsce": "^2.22.0",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0"
    },
    "extensionDependencies": [],
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "lint": "eslint src --ext ts",
        "package": "vsce package"
    },
    "icon": "images/docomment.png",
    "license": "MIT",
    "homepage": "https://github.com/alexermolov/CDocComments#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/alexermolov/CDocComments"
    },
    "bugs": {
        "url": "https://github.com/alexermolov/CDocComments/issues"
    }
}
